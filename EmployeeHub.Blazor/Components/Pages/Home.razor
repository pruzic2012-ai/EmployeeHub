@page "/home"
@inherits HomeBase
@rendermode InteractiveServer

<PageTitle>Employees - EmployeeHub</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Employees</h2>
        <p class="text-muted mb-0">
            Manage your organization's employees
        </p>
    </div>

    <a class="btn btn-primary"
       href="/add-employee">
        <span class="me-1">+</span>
        Add Employee
    </a>
</div>
@if (!string.IsNullOrWhiteSpace(ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        @ErrorMessage
    </div>
}
<div class="card shadow-sm">
    <div class="card-body p-0">

        @if (Employees.Count == 0)
        {
            <div class="p-4 text-center text-muted">
                No employees found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Department</th>
                            <th>Salary</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var employee in Employees)
                        {
                            <tr>
                                <td class="ps-4 text-muted">
                                    @employee.Id
                                </td>

                                <td>
                                    <div class="fw-semibold">
                                        @employee.FirstName @employee.LastName
                                    </div>
                                </td>

                                <td>
                                    @employee.Email
                                </td>

                                <td>
                                    <span class="badge bg-secondary">
                                        @employee.Department
                                    </span>
                                </td>

                                <td class="fw-semibold">
                                    @employee.Salary.ToString("C")
                                </td>

                                <td class="text-end pe-4">
                                    <a class="btn btn-sm btn-outline-primary me-2"
                                       href="@($"/edit-employee/{employee.Id}")">
                                        Edit
                                    </a>

                                    
                                    <button class="btn btn-sm btn-outline-danger"
                                            @onclick="() => ConfirmDeleteAsync(employee.Id)"
                                            disabled="@DeletingEmployeeId.HasValue">

                                        @if (DeletingEmployeeId == employee.Id)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1"
                                                  role="status"
                                                  aria-hidden="true"></span>
                                            <span>Deleting...</span>
                                        }
                                        else
                                        {
                                            <span>Delete</span>
                                        }

                                    </button>

                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }

    </div>
</div>

<div class="mt-3 text-muted small">
    Showing @Employees.Count employee(s)
</div>